[Control] 
initial_config = ./initial_config.xyz 
n_steps = 20
engine = lammps
verbosity = 2
n_sessions = 7
engine_use_rank_0 = False
basin = False

[Lammps] 
pair_style = eam/alloy 
pair_coeff = * * FeC-Becquart2013.eam Fe
min_style = cg 
minimize = 1e-10 1e-12 1000 1000

[AtomicEnvironment] 
style = cna/graph
rnei = 2.8
rcut = 6.0
neighbors_add = 1

[EventSearch] 
style = partn
nsearch = 20
emax_event = 5.0
emin_event = 0.0

[pARTn]
# Search settings measured for vacancies in bcc Fe (see docs/best_practices.md).
# Do not use them for a cell with a self-interstitial.
# The three changes work together: a push that also moves the first and second neighbours,
# a stricter curvature threshold, and retries when the curvature turns positive again.
push_dist_thr = 4.0
push_step_size = 0.3
eigval_thr = -0.5
nnewchance = 3

[RateConstant] 
style = constant
k0 = 10
T = 300.0

[PSR] 
style = ira 
matching_score_thr = 0.3

[IRA]
kmax_factor = 2.0

[Basin]
energy_thr = 0.6
